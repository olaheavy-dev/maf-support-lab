<Project Sdk="Microsoft.NET.Sdk">

  <!-- The evaluation runner (L29+). It talks to either backend over HTTP only: it references no application project,
       and the application manifests never gain evaluation dependencies. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Support.Evaluations</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <!-- L30: MAF's local evaluation (EvalItem, LocalEvaluator, EvaluateAsync) and the Microsoft.Extensions.AI.Evaluation
         abstractions it builds on. Evaluation-only: no application project references them. -->
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation" />
    <!-- L32: the AI-judged quality evaluators (Relevance, Groundedness) and the Anthropic SDK for the judge client.
         Only the explicit live quality lane calls a model. -->
    <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" />
    <PackageReference Include="Anthropic" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Support.Evaluations.Tests" />
  </ItemGroup>

</Project>
