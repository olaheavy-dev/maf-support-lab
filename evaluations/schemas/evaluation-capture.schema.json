{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.maf-support-lab.example/evaluations/v1/evaluation-capture.schema.json",
  "title": "Captured conversation",
  "description": "One recorded agent turn for native evaluation (L30): the query, the agent's response messages with tool calls, results and paused approvals, the tools it had, and the case it came from. Normalized, so no SDK's internal serialization leaks into it.",
  "type": "object",
  "required": [
    "schema_version",
    "capture_id",
    "dataset_id",
    "dataset_version",
    "case_id",
    "source",
    "agent",
    "tools",
    "query",
    "messages",
    "response_text"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,80}$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "source": {
      "description": "fake-agent: recorded from the scripted evaluation agent (no credentials).",
      "enum": [
        "fake-agent"
      ]
    },
    "agent": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "principal": {
      "type": "string",
      "pattern": "^CUST-[0-9]{4}$"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "writes"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "writes": {
            "type": "boolean"
          }
        }
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "contents"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "assistant",
              "tool"
            ]
          },
          "contents": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/content"
            }
          }
        }
      }
    },
    "response_text": {
      "type": "string",
      "maxLength": 8000
    }
  },
  "$defs": {
    "content": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "text",
            "function_call",
            "function_result",
            "approval_request"
          ]
        },
        "text": {
          "type": "string"
        },
        "call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "arguments": {
          "type": "object"
        },
        "result": {
          "type": "string",
          "maxLength": 8000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "function_call",
                  "approval_request"
                ]
              }
            }
          },
          "then": {
            "required": [
              "call_id",
              "name",
              "arguments"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "function_result"
              }
            }
          },
          "then": {
            "required": [
              "call_id",
              "result"
            ]
          }
        }
      ]
    }
  }
}
