{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.maf-support-lab.example/evaluations/v1/evaluation-run.schema.json",
  "title": "Evaluation run",
  "description": "The normalized result of running one dataset against one backend (L29). Everything needed to reproduce it is in `run`; per-case evidence is observable API facts, never SDK-internal serialization.",
  "type": "object",
  "required": [
    "schema_version",
    "run",
    "results",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "1.1 (L16): restart and get_operation evidence; 1.2 (L30): an evidence link per case. Older documents stay valid.",
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "started_at",
        "finished_at",
        "backend",
        "source_commit",
        "model",
        "dataset",
        "scorer",
        "runner",
        "configuration"
      ],
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^run_[0-9a-f]{32}$"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "backend": {
          "enum": [
            "dotnet",
            "python"
          ]
        },
        "source_commit": {
          "description": "The repository commit the backend ran from, or unknown.",
          "type": "string",
          "pattern": "^([0-9a-f]{40}|unknown)$"
        },
        "model": {
          "type": "object",
          "required": [
            "mode",
            "model_id"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "fake",
                "recorded",
                "live"
              ]
            },
            "model_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 100
            }
          }
        },
        "dataset": {
          "type": "object",
          "required": [
            "dataset_id",
            "dataset_version",
            "splits"
          ],
          "additionalProperties": false,
          "properties": {
            "dataset_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,63}$"
            },
            "dataset_version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "splits": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "development",
                  "heldout"
                ]
              }
            }
          }
        },
        "scorer": {
          "$ref": "#/$defs/component"
        },
        "runner": {
          "$ref": "#/$defs/component"
        },
        "configuration": {
          "description": "Run options that change results (for example whether writes were allowed). No secrets, URLs with credentials, or customer data.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case_result"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "passed",
        "failed",
        "error",
        "skipped"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "case_result": {
      "type": "object",
      "required": [
        "case_id",
        "split",
        "status",
        "latency_ms",
        "steps",
        "usage"
      ],
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "split": {
          "enum": [
            "development",
            "heldout"
          ]
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped"
          ]
        },
        "skip_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "error": {
          "description": "Safe description of a runner error (never a response body or stack trace).",
          "type": "string",
          "maxLength": 300
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step_result"
          }
        },
        "usage": {
          "description": "Token usage, only when the backend reports it. Unknown stays unknown: never zero.",
          "type": "object",
          "required": [
            "available"
          ],
          "additionalProperties": false,
          "properties": {
            "available": {
              "type": "boolean"
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "if": {
            "properties": {
              "available": {
                "const": false
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "input_tokens"
                  ]
                },
                {
                  "required": [
                    "output_tokens"
                  ]
                }
              ]
            }
          }
        },
        "evidence": {
          "description": "L30: where the evaluated evidence lives (for example a recorded conversation), repository-relative.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]{1,200}$"
        },
        "checks": {
          "description": "L30: case-level checks from a native evaluator (no HTTP steps), same shape as step checks.",
          "$ref": "#/$defs/step_result/properties/checks"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "skipped"
              }
            }
          },
          "then": {
            "required": [
              "skip_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "error"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "step_result": {
      "type": "object",
      "required": [
        "index",
        "action",
        "http_status",
        "latency_ms",
        "observed",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "enum": [
            "send",
            "resend_previous",
            "decide",
            "send_raw",
            "restart",
            "get_operation"
          ]
        },
        "http_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "observed": {
          "description": "Observable facts from the response and its stream; null when not applicable.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "outcome": {
              "type": [
                "string",
                "null"
              ]
            },
            "error_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "problem_code": {
              "type": [
                "string",
                "null"
              ]
            },
            "route_status": {
              "type": [
                "string",
                "null"
              ]
            },
            "route_target": {
              "type": [
                "string",
                "null"
              ]
            },
            "unrouted_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "reply_kind": {
              "type": [
                "string",
                "null"
              ]
            },
            "operation_kind": {
              "type": [
                "string",
                "null"
              ]
            },
            "operation_status": {
              "type": [
                "string",
                "null"
              ]
            },
            "turn_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "operation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "operation_result": {
              "type": [
                "object",
                "null"
              ]
            },
            "cancelled": {
              "description": "Whether the runner asked for a cancel during this step.",
              "type": "boolean"
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "passed"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z_]+$"
              },
              "passed": {
                "type": "boolean"
              },
              "expected": {},
              "actual": {}
            }
          }
        }
      }
    }
  }
}
