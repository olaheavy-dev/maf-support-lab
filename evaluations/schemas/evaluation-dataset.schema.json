{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.maf-support-lab.example/evaluations/v1/evaluation-dataset.schema.json",
  "title": "Evaluation dataset",
  "description": "A versioned set of behaviour cases run against either backend through the public API (L29). Cases assert observable contract facts (routes, outcomes, reply kinds, operation states, problem codes, tools seen in the stream), never exact wording.",
  "type": "object",
  "required": ["schema_version", "dataset_id", "dataset_version", "category", "description", "fixture_version", "live_run", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "dataset_id": { "$ref": "#/$defs/slug" },
    "dataset_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "category": { "enum": ["success", "ambiguity", "denial", "failure", "adversarial"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "fixture_version": { "description": "The fixtures/ version the expectations were written against.", "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "live_run": {
      "description": "Budget for an explicitly invoked live-model run of this dataset. Fake mode has no budget.",
      "type": "object",
      "required": ["eligible", "max_cases", "max_model_calls_per_case", "repetitions"],
      "additionalProperties": false,
      "properties": {
        "eligible": { "type": "boolean" },
        "max_cases": { "type": "integer", "minimum": 0, "maximum": 50 },
        "max_model_calls_per_case": { "type": "integer", "minimum": 1, "maximum": 20 },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "cases": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "customer_id": { "type": "string", "pattern": "^CUST-[0-9]{4}$" },
    "case": {
      "type": "object",
      "required": ["case_id", "split", "principal", "purpose", "source", "writes", "reset", "steps", "expected_state_change"],
      "additionalProperties": false,
      "properties": {
        "case_id": { "$ref": "#/$defs/slug" },
        "split": {
          "description": "development cases may be used while changing prompts or code; heldout cases are only run to measure, never tuned against.",
          "enum": ["development", "heldout"]
        },
        "principal": { "$ref": "#/$defs/customer_id" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 300 },
        "source": { "description": "The feature scenario it came from (S01…S19), or new.", "type": "string", "pattern": "^(S[0-9]{2}-[a-z0-9-]+|new)$" },
        "writes": { "description": "Whether the case changes simulated state (an approved write). Write cases need an isolated store.", "type": "boolean" },
        "reset": {
          "description": "What must be fresh before the case runs: its own conversation (read-only cases), or its own store (write cases).",
          "enum": ["fresh_conversation", "fresh_store"]
        },
        "context": {
          "description": "Fixture records the expected answer is grounded in, as file:id (for later groundedness scoring).",
          "type": "array",
          "items": { "type": "string", "pattern": "^(orders|invoices|payments|knowledge-base|policies|customers):[A-Za-z0-9-]+$" }
        },
        "steps": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/step" } },
        "expected_state_change": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["none", "order_cancelled", "refund_recorded", "ticket_created"] },
            "order_id": { "type": "string", "pattern": "^ORD-[0-9]{4}$" }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "writes": { "const": true } } }, "then": { "properties": { "reset": { "const": "fresh_store" } } } }
      ]
    },
    "step": {
      "type": "object",
      "required": ["action", "expect"],
      "additionalProperties": false,
      "properties": {
        "action": { "enum": ["send", "resend_previous", "decide", "send_raw"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "decision": { "enum": ["approve", "reject"] },
        "raw_body": { "description": "send_raw only: the exact JSON body, for contract-violation cases.", "type": "object" },
        "as_principal": { "$ref": "#/$defs/customer_id" },
        "expect": { "$ref": "#/$defs/expectation" }
      },
      "allOf": [
        { "if": { "properties": { "action": { "const": "send" } } }, "then": { "required": ["message"] } },
        { "if": { "properties": { "action": { "const": "decide" } } }, "then": { "required": ["decision"] } },
        { "if": { "properties": { "action": { "const": "send_raw" } } }, "then": { "required": ["raw_body"] } }
      ]
    },
    "expectation": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "http_status": { "type": "integer", "minimum": 200, "maximum": 599 },
        "problem_code": { "type": "string", "pattern": "^[a-z_]+$" },
        "outcome": { "enum": ["completed", "awaiting_approval", "failed", "cancelled"] },
        "error_code": { "type": "string", "pattern": "^[a-z_]+$" },
        "route_status": { "enum": ["routed", "unrouted"] },
        "route_target": { "enum": ["orders", "billing", "technical"] },
        "unrouted_reason": { "enum": ["invalid_model_output", "ambiguous_request"] },
        "reply_kind": { "enum": ["answer", "clarification", "not_found", "not_eligible", "escalation_offer", "approval_request", "approval_result"] },
        "operation_kind": { "enum": ["cancel_order", "refund_order", "create_ticket"] },
        "operation_status": { "enum": ["awaiting_approval", "running", "committed", "rejected", "failed", "expired"] },
        "tools": { "description": "Tools that must appear in the stream's tool_call progress events.", "type": "array", "items": { "type": "string", "pattern": "^[a-z_]+$" } },
        "tools_absent": { "description": "Tools that must not be called.", "type": "array", "items": { "type": "string", "pattern": "^[a-z_]+$" } },
        "mentions": { "description": "Content check (not authorization evidence): text the reply must contain.", "type": "array", "items": { "type": "string", "minLength": 1 } },
        "must_not_mention": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "same_turn_as_previous": { "type": "boolean" },
        "same_operation_as_previous": { "type": "boolean" }
      }
    }
  }
}
