{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.maf-support-lab.example/v1/fixtures.schema.json",
  "title": "Synthetic fixture files",
  "$defs": {
    "customers_file": {
      "type": "object",
      "required": [
        "fixture_version",
        "customers"
      ],
      "additionalProperties": false,
      "properties": {
        "fixture_version": {
          "const": "1.0"
        },
        "customers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "customer_id",
              "display_name",
              "email"
            ],
            "additionalProperties": false,
            "properties": {
              "customer_id": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/customer_id"
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "email": {
                "type": "string",
                "pattern": "^[a-z0-9._-]+@example\\.com$"
              }
            }
          }
        }
      }
    },
    "orders_file": {
      "type": "object",
      "required": [
        "fixture_version",
        "orders"
      ],
      "additionalProperties": false,
      "properties": {
        "fixture_version": {
          "const": "1.0"
        },
        "orders": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "order_id",
              "customer_id",
              "status",
              "placed_at",
              "shipped_at",
              "delivered_at",
              "refund_status",
              "items",
              "total"
            ],
            "additionalProperties": false,
            "properties": {
              "order_id": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/order_id"
              },
              "customer_id": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/customer_id"
              },
              "status": {
                "enum": [
                  "processing",
                  "shipped",
                  "delivered",
                  "cancelled"
                ]
              },
              "placed_at": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/timestamp"
              },
              "shipped_at": {
                "oneOf": [
                  {
                    "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/timestamp"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "delivered_at": {
                "oneOf": [
                  {
                    "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/timestamp"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "refund_status": {
                "enum": [
                  "none",
                  "refunded"
                ]
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "sku",
                    "name",
                    "quantity",
                    "unit_price"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "sku": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}-[0-9]{3}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "unit_price": {
                      "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/money"
                    }
                  }
                }
              },
              "total": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/money"
              }
            }
          }
        }
      }
    },
    "invoices_file": {
      "type": "object",
      "required": [
        "fixture_version",
        "invoices"
      ],
      "additionalProperties": false,
      "properties": {
        "fixture_version": {
          "const": "1.0"
        },
        "invoices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "invoice_id",
              "order_id",
              "customer_id",
              "issued_at",
              "lines",
              "subtotal",
              "tax",
              "total",
              "payment_method"
            ],
            "additionalProperties": false,
            "properties": {
              "invoice_id": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/invoice_id"
              },
              "order_id": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/order_id"
              },
              "customer_id": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/customer_id"
              },
              "issued_at": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/timestamp"
              },
              "lines": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "description",
                    "quantity",
                    "amount"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quantity": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "amount": {
                      "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/money"
                    }
                  }
                }
              },
              "subtotal": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/money"
              },
              "tax": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/money"
              },
              "total": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/money"
              },
              "payment_method": {
                "type": "string",
                "pattern": "^card_ending_[0-9]{4}$"
              }
            }
          }
        }
      }
    },
    "payments_file": {
      "type": "object",
      "required": [
        "fixture_version",
        "payments"
      ],
      "additionalProperties": false,
      "properties": {
        "fixture_version": {
          "const": "1.0"
        },
        "payments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "payment_id",
              "customer_id",
              "order_id",
              "invoice_id",
              "paid_at",
              "amount",
              "method",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "payment_id": {
                "type": "string",
                "pattern": "^PAY-[0-9]{4}$"
              },
              "customer_id": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/customer_id"
              },
              "order_id": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/order_id"
              },
              "invoice_id": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/invoice_id"
              },
              "paid_at": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/timestamp"
              },
              "amount": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/money"
              },
              "method": {
                "type": "string",
                "pattern": "^card_ending_[0-9]{4}$"
              },
              "kind": {
                "enum": [
                  "charge",
                  "refund"
                ]
              }
            }
          }
        }
      }
    },
    "knowledge_base_file": {
      "type": "object",
      "required": [
        "fixture_version",
        "articles"
      ],
      "additionalProperties": false,
      "properties": {
        "fixture_version": {
          "const": "1.0"
        },
        "articles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "article_id",
              "title",
              "keywords",
              "steps"
            ],
            "additionalProperties": false,
            "properties": {
              "article_id": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/article_id"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "keywords": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                }
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    },
    "policies_file": {
      "type": "object",
      "required": [
        "fixture_version",
        "reference_time",
        "cancellation",
        "refund",
        "support_ticket",
        "approval"
      ],
      "additionalProperties": false,
      "properties": {
        "fixture_version": {
          "const": "1.0"
        },
        "reference_time": {
          "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/timestamp"
        },
        "cancellation": {
          "type": "object",
          "required": [
            "allowed_statuses"
          ],
          "additionalProperties": false,
          "properties": {
            "allowed_statuses": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "processing",
                  "shipped",
                  "delivered",
                  "cancelled"
                ]
              }
            }
          }
        },
        "refund": {
          "type": "object",
          "required": [
            "required_status",
            "window_days",
            "window_measured_from",
            "eligible_refund_statuses",
            "amount"
          ],
          "additionalProperties": false,
          "properties": {
            "required_status": {
              "const": "delivered"
            },
            "window_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "window_measured_from": {
              "const": "delivered_at"
            },
            "eligible_refund_statuses": {
              "type": "array",
              "items": {
                "enum": [
                  "none",
                  "refunded"
                ]
              }
            },
            "amount": {
              "const": "order_total"
            }
          }
        },
        "support_ticket": {
          "type": "object",
          "required": [
            "priorities"
          ],
          "additionalProperties": false,
          "properties": {
            "priorities": {
              "type": "array",
              "items": {
                "enum": [
                  "low",
                  "normal",
                  "high"
                ]
              }
            }
          }
        },
        "approval": {
          "type": "object",
          "required": [
            "required_for",
            "expires_after_minutes"
          ],
          "additionalProperties": false,
          "properties": {
            "required_for": {
              "type": "array",
              "items": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/operation_kind"
              }
            },
            "expires_after_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            }
          }
        }
      }
    },
    "expectation": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "route_status": {
          "enum": [
            "routed",
            "unrouted"
          ]
        },
        "route_target": {
          "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/route_target"
        },
        "outcome": {
          "enum": [
            "completed",
            "awaiting_approval",
            "failed",
            "cancelled"
          ]
        },
        "reply_kind": {
          "enum": [
            "answer",
            "clarification",
            "not_found",
            "not_eligible",
            "escalation_offer",
            "approval_request",
            "approval_result",
            "refusal"
          ]
        },
        "operation_kind": {
          "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/operation_kind"
        },
        "operation_status": {
          "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/operation_status"
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_not_mention": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "http_status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "problem_code": {
          "type": "string"
        },
        "same_turn_as_previous": {
          "const": true
        },
        "same_operation_as_previous": {
          "const": true
        }
      },
      "minProperties": 1
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "action",
            "message",
            "expect"
          ],
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "send"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "expect": {
              "$ref": "#/$defs/expectation"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "action",
            "decision",
            "expect"
          ],
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "decide"
            },
            "decision": {
              "enum": [
                "approve",
                "reject"
              ]
            },
            "as_principal": {
              "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/customer_id"
            },
            "expect": {
              "$ref": "#/$defs/expectation"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "action",
            "expect"
          ],
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "resend_previous"
            },
            "expect": {
              "$ref": "#/$defs/expectation"
            }
          }
        }
      ]
    },
    "state_change": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "ticket_created"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "order_id"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "order_cancelled",
                "refund_recorded"
              ]
            },
            "order_id": {
              "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/order_id"
            }
          }
        }
      ]
    },
    "scenarios_file": {
      "type": "object",
      "required": [
        "fixture_version",
        "description",
        "scenarios"
      ],
      "additionalProperties": false,
      "properties": {
        "fixture_version": {
          "const": "1.0"
        },
        "description": {
          "type": "string"
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "scenario_id",
              "principal",
              "purpose",
              "steps",
              "expected_state_change"
            ],
            "additionalProperties": false,
            "properties": {
              "scenario_id": {
                "type": "string",
                "pattern": "^S[0-9]{2}-[a-z0-9-]+$"
              },
              "principal": {
                "$ref": "https://contracts.maf-support-lab.example/v1/common.schema.json#/$defs/customer_id"
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/step"
                }
              },
              "expected_state_change": {
                "$ref": "#/$defs/state_change"
              }
            }
          }
        }
      }
    }
  }
}
